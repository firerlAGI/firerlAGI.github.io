---
interface Props {
  text: string
  tag?: 'h1' | 'h2' | 'h3' | 'p' | 'span'
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span'
  class?: string
  className?: string
  [key: string]: any
}

const { 
  text, 
  tag = 'span', 
  as,
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const Tag = as ?? tag
const classes = `cyber-glitch-effect font-cyber uppercase tracking-[0.18em] ${classProp} ${className}`.trim()
---

<Tag class={classes} data-text={text} {...rest}>{text}</Tag>
