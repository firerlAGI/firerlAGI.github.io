---
interface Props {
  glowColor?: 'cyan' | 'pink'
  title?: string
  titleI18n?: string
  class?: string
  className?: string
  noPadding?: boolean
}

const { 
  glowColor = 'cyan', 
  title, 
  titleI18n,
  class: classProp = '',
  className = '',
  noPadding = false
} = Astro.props

const tone = glowColor === 'cyan'
  ? {
      border: 'rgba(99, 230, 255, 0.24)',
      accent: 'var(--cyber-cyan)',
      accentSoft: 'rgba(99, 230, 255, 0.14)',
    }
  : {
      border: 'rgba(255, 119, 221, 0.22)',
      accent: 'var(--cyber-fuchsia)',
      accentSoft: 'rgba(255, 119, 221, 0.14)',
    }

const rootClassName = `${classProp} ${className}`.trim()
---

<div class={`neo-card group relative ${rootClassName}`} style={`--neo-border:${tone.border}; --neo-accent:${tone.accent}; --neo-accent-soft:${tone.accentSoft};`}>
  <div class:list={['neo-card__body', !noPadding && 'p-6 md:p-7']}>
    {title && (
      <div class="neo-card__header">
        <div class="neo-card__title-dot"></div>
        <h3 class="neo-card__title" data-i18n={titleI18n}>
          {title}
        </h3>
        <div class="neo-card__rule"></div>
      </div>
    )}

    <div class="neo-card__content">
      <slot />
    </div>
  </div>
</div>

<style>
  .neo-card {
    height: 100%;
  }

  .neo-card__body {
    position: relative;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--neo-border) 88%, rgba(255, 255, 255, 0.03));
    border-radius: 1.6rem;
    background:
      linear-gradient(180deg, rgba(14, 20, 37, 0.94), rgba(9, 13, 25, 0.82)),
      rgba(11, 16, 32, 0.82);
    backdrop-filter: blur(20px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 18px 48px rgba(2, 6, 23, 0.28);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .neo-card__body::before,
  .neo-card__body::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .neo-card__body::before {
    inset: 0;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--neo-accent-soft) 68%, transparent), transparent 26%),
      linear-gradient(rgba(255, 255, 255, 0.035), transparent 22%);
    opacity: 0.62;
  }

  .neo-card:hover .neo-card__body {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--neo-accent) 28%, rgba(255, 255, 255, 0.05));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 22px 58px rgba(2, 6, 23, 0.34);
  }

  .neo-card__header,
  .neo-card__content {
    position: relative;
    z-index: 1;
  }

  .neo-card__header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.15rem;
  }

  .neo-card__title-dot {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 999px;
    background: var(--neo-accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--neo-accent) 40%, transparent);
  }

  .neo-card__title {
    color: var(--text-primary);
    font-family: var(--font-cyber);
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .neo-card__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--neo-accent) 40%, transparent), transparent);
  }

  .neo-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }
</style>
