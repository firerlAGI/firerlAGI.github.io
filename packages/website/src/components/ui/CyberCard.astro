---
interface Props {
  glowColor?: 'cyan' | 'pink'
  title?: string
  titleI18n?: string
  class?: string
  className?: string
  noPadding?: boolean
}

const { 
  glowColor = 'cyan', 
  title, 
  titleI18n,
  class: classProp = '',
  className = '',
  noPadding = false
} = Astro.props

const tone = glowColor === 'cyan'
  ? {
      border: 'rgba(99, 230, 255, 0.24)',
      accent: 'var(--cyber-cyan)',
      accentSoft: 'rgba(99, 230, 255, 0.14)',
    }
  : {
      border: 'rgba(255, 119, 221, 0.22)',
      accent: 'var(--cyber-fuchsia)',
      accentSoft: 'rgba(255, 119, 221, 0.14)',
    }

const rootClassName = `${classProp} ${className}`.trim()
---

<div class={`neo-card group relative ${rootClassName}`} style={`--neo-border:${tone.border}; --neo-accent:${tone.accent}; --neo-accent-soft:${tone.accentSoft};`}>
  <div class:list={['neo-card__body', !noPadding && 'p-6 md:p-7']}>
    {title && (
      <div class="neo-card__header">
        <div class="neo-card__title-dot"></div>
        <h3 class="neo-card__title" data-i18n={titleI18n}>
          {title}
        </h3>
        <div class="neo-card__rule"></div>
      </div>
    )}

    <div class="neo-card__content">
      <slot />
    </div>
  </div>
</div>

<style>
  .neo-card {
    height: 100%;
  }

  .neo-card__body {
    position: relative;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.5rem;
    background: var(--card-bg);
    backdrop-filter: blur(40px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .neo-card:hover .neo-card__body {
    transform: scale(1.01);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }

  .neo-card__header,
  .neo-card__content {
    position: relative;
    z-index: 1;
  }

  .neo-card__header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.15rem;
  }

  .neo-card__title-dot {
    display: none;
  }

  .neo-card__title {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .neo-card__rule {
    display: none;
  }

  .neo-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: var(--text-secondary);
    font-family: var(--font-family);
  }
</style>
