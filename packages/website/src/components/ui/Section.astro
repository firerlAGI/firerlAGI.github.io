---
interface Props {
  sectionId?: string
  class?: string
  alt?: boolean
}

const { sectionId, class: className = '', alt = false } = Astro.props
---

<section id={sectionId} class={`section scroll-mt-28 w-full flex flex-col items-center relative ${alt ? 'section-alt' : ''} ${className}`}>
  <slot />
</section>

<style>
  :global(.section) {
    transition: background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.section-alt) {
    background: linear-gradient(180deg, rgba(8, 12, 28, 0.16), rgba(8, 12, 28, 0.3));
  }
</style>
