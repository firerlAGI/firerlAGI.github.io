---
import LanguageSwitcher from '../react/LanguageSwitcher'

const pathname = Astro.url.pathname

const navItems = [
  { href: '/about', label: '/ABOUT', key: 'nav.about', active: pathname === '/about' },
  { href: '/#skills', label: '/ACTIVITY', key: 'nav.skills', active: false },
  { href: '/#projects', label: '/PROJECTS', key: 'nav.projects', active: false },
  { href: '/#blog', label: '/LOGS', key: 'nav.blog', active: false },
  { href: '/#contact', label: '/CONTACT', key: 'nav.contact', active: false },
]
---

<nav class="site-nav" data-site-nav>
  <div class="site-nav__inner">
    <a href="/" class="site-nav__brand" aria-label="返回首页">
      <span class="site-nav__brand-mark">FR</span>
      <span class="site-nav__brand-copy">
        <strong>firerlAGI</strong>
        <small>AI-native builder</small>
      </span>
    </a>

    <div class="site-nav__desktop">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['site-nav__link', item.active && 'is-active']}
          data-i18n={item.key}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="site-nav__actions">
      <div class="hidden md:block">
        <LanguageSwitcher client:idle />
      </div>
      <button
        class="site-nav__toggle"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="site-nav-drawer"
        data-nav-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="site-nav__overlay" data-nav-overlay></div>
<aside class="site-nav__drawer" id="site-nav-drawer" data-nav-drawer aria-hidden="true">
  <div class="site-nav__drawer-panel">
    <div class="site-nav__drawer-header">
      <div>
        <p class="site-nav__drawer-label">Navigation</p>
        <p class="site-nav__drawer-title">Explore the interface</p>
      </div>
      <div class="md:hidden">
        <LanguageSwitcher client:idle />
      </div>
    </div>

    <div class="site-nav__drawer-links">
      {navItems.map((item) => (
        <a href={item.href} class="site-nav__drawer-link" data-nav-link data-i18n={item.key}>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</aside>

<script>
  const navRoot = document.querySelector('[data-site-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const overlay = document.querySelector('[data-nav-overlay]');
  const drawer = document.querySelector('[data-nav-drawer]');
  const links = document.querySelectorAll('[data-nav-link]');

  if (navRoot && toggle && overlay && drawer) {
    const setOpen = (open) => {
      navRoot.dataset.open = open ? 'true' : 'false';
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      const next = navRoot.dataset.open !== 'true';
      setOpen(next);
    });

    overlay.addEventListener('click', () => setOpen(false));
    links.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    window.addEventListener('scroll', () => {
      if (window.scrollY > 16) {
        navRoot.classList.add('is-scrolled');
      } else {
        navRoot.classList.remove('is-scrolled');
      }
    });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 80;
    width: 100%;
    padding: 1.15rem 0 0.75rem;
    transition: padding 0.25s ease, transform 0.25s ease;
  }

  .site-nav__inner {
    width: min(calc(100% - 2rem), var(--container-width));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.82rem 0.95rem 0.82rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 999px;
    background: rgba(29, 29, 31, 0.72);
    backdrop-filter: blur(24px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .site-nav.is-scrolled .site-nav__inner {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(29, 29, 31, 0.85);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .site-nav__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 0.92rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .site-nav__brand-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .site-nav__brand-copy strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-nav__brand-copy small {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .site-nav__desktop {
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.26rem;
    border-radius: 999px;
    border: 1px solid rgba(126, 154, 218, 0.08);
    background: rgba(255, 255, 255, 0.015);
  }

  .site-nav__link {
    padding: 0.68rem 0.92rem;
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--text-primary);
    background: rgba(120, 215, 248, 0.08);
    transform: translateY(-1px);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-nav__toggle {
    width: 2.9rem;
    height: 2.9rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    border: 1px solid rgba(126, 154, 218, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.018);
    color: var(--text-primary);
  }

  .site-nav__toggle span {
    width: 1.1rem;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .site-nav[data-open="true"] .site-nav__toggle span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-nav[data-open="true"] .site-nav__toggle span:nth-child(2) {
    opacity: 0;
  }

  .site-nav[data-open="true"] .site-nav__toggle span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav__overlay {
    position: fixed;
    inset: 0;
    background: rgba(4, 8, 19, 0.7);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 70;
  }

  .site-nav__drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 24rem);
    padding: 1rem;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    z-index: 75;
  }

  .site-nav__drawer-panel {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.4rem;
    border: 1px solid rgba(126, 154, 218, 0.14);
    border-radius: 1.8rem;
    background: rgba(8, 12, 24, 0.94);
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 56px rgba(2, 6, 23, 0.36);
  }

  .site-nav__drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-nav__drawer-label {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .site-nav__drawer-title {
    margin-top: 0.45rem;
    color: var(--text-primary);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .site-nav__drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .site-nav__drawer-link {
    display: flex;
    align-items: center;
    min-height: 3.8rem;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(126, 154, 218, 0.12);
    border-radius: 1.2rem;
    background: rgba(15, 22, 44, 0.44);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .site-nav__drawer-link:hover {
    transform: translateX(3px);
    border-color: rgba(120, 215, 248, 0.24);
  }

  .site-nav[data-open="true"] + .site-nav__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .site-nav[data-open="true"] ~ .site-nav__drawer {
    transform: translateX(0);
  }

  @media (min-width: 768px) {
    .site-nav__desktop {
      display: inline-flex;
    }

    .site-nav__toggle {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .site-nav {
      padding-inline: 0.75rem;
    }

    .site-nav__inner {
      width: 100%;
    }
  }
</style>
