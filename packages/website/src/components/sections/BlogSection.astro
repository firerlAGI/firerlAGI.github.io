---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import { ArrowUpRight, Calendar, Hash } from 'lucide-react'
import { getCollection } from 'astro:content'
import { translations, type Language } from '../../translations'

const allPosts = await getCollection('blog')

const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const lang: Language = 'en'
const t = translations[lang]

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date).replace(/\//g, '.')
---

<Section sectionId="blog" class="py-16 md:py-24">
  <Container>
    <div class="section-heading-block animate-on-scroll">
      <span class="section-kicker">Writing</span>
      <h2 class="section-title" data-i18n="blog.title">{t.blog.title}</h2>
      <p class="section-description" data-i18n="blog.subtitle">{t.blog.subtitle}</p>
    </div>

    <div class="blog-grid">
      {posts.map((post, index) => (
        <CyberCard glowColor={index % 2 === 0 ? 'pink' : 'cyan'} class="animate-on-scroll">
          <article class="blog-card">
            <div class="blog-card__meta">
              <span><Calendar size={12} /> {formatDate(post.data.date)}</span>
              <span><Hash size={12} /> {post.data.category}</span>
            </div>

            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>

            <a
              href={post.data.externalUrl || `/blog/${post.slug}`}
              target={post.data.externalUrl ? '_blank' : undefined}
              rel={post.data.externalUrl ? 'noopener noreferrer' : undefined}
              class="blog-card__link"
            >
              <span data-i18n="blog.readMore">{t.blog.readMore}</span>
              <ArrowUpRight size={15} />
            </a>
          </article>
        </CyberCard>
      ))}
    </div>
  </Container>
</Section>

<style>
  .blog-grid {
    display: grid;
    gap: 1.1rem;
  }

  .blog-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .blog-card__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blog-card h3 {
    color: var(--text-primary);
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .blog-card p {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    width: fit-content;
    min-height: 2.9rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 119, 221, 0.18);
    background: rgba(255, 119, 221, 0.06);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .blog-card__link:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 119, 221, 0.34);
  }

  @media (min-width: 720px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1120px) {
    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
