---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import { projects } from '../../data/projects'
import { translations, type Language } from '../../translations'
import { Brain, Bot, ArrowUpRight } from 'lucide-react'

const lang: Language = 'en'
const t = translations[lang]

const iconMap = {
  Brain,
  Bot,
}
---

<Section sectionId="projects" class="py-16 md:py-24">
  <Container>
    <div class="section-heading-block animate-on-scroll">
      <span class="section-kicker">Projects</span>
      <h2 class="section-title" data-i18n="projects.title">{t.projects.title}</h2>
      <p class="section-description" data-i18n="projects.subtitle">{t.projects.subtitle}</p>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => {
        const Icon = iconMap[project.icon as keyof typeof iconMap] || Brain

        return (
          <CyberCard glowColor={index % 2 === 0 ? 'cyan' : 'pink'} class="animate-on-scroll">
            <article class="project-card">
              <div class="project-card__media">
                {project.image ? (
                  <>
                    <img
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                      data-i18n={`project_items.${project.id}.title`}
                      data-i18n-target="alt"
                    />
                    <span class="project-card__media-shine"></span>
                  </>
                ) : (
                  <div class="project-card__fallback">
                    <Icon size={34} />
                  </div>
                )}
              </div>

              <div class="project-card__body">
                <div class="project-card__header">
                  <div class="project-card__icon">
                    <Icon size={18} />
                  </div>
                  <span class="project-card__note" data-i18n={`project_items.${project.id}.note`}>
                    {project.note || 'VIEW PROJECT'}
                  </span>
                </div>

                <h3 data-i18n={`project_items.${project.id}.title`}>{project.title}</h3>
                <p data-i18n={`project_items.${project.id}.description`}>{project.description}</p>

                {project.techBadges?.length ? (
                  <div class="project-card__tags">
                    {project.techBadges.map((tech) => (
                      <span class="tech-pill" data-i18n={`tech.${tech}`}>{tech}</span>
                    ))}
                  </div>
                ) : null}

                <div class="project-card__actions">
                  {project.ctaHref && project.ctaHref !== '#' ? (
                    <a href={project.ctaHref} target="_blank" rel="noopener noreferrer" class="project-card__link project-card__link--primary">
                      <span data-i18n="projects.code">{t.projects.code}</span>
                      <ArrowUpRight size={16} />
                    </a>
                  ) : (
                    <span class="project-card__link project-card__link--muted">
                      <span data-i18n="projects.code">{t.projects.code}</span>
                    </span>
                  )}

                  {project.demoHref && project.demoHref !== '#' ? (
                    <a href={project.demoHref} target="_blank" rel="noopener noreferrer" class="project-card__link project-card__link--secondary">
                      <span data-i18n="projects.demo">{t.projects.demo}</span>
                      <ArrowUpRight size={16} />
                    </a>
                  ) : (
                    <span class="project-card__link project-card__link--muted">
                      <span data-i18n="projects.demo">{t.projects.demo}</span>
                    </span>
                  )}
                </div>
              </div>
            </article>
          </CyberCard>
        )
      })}
    </div>

    <div class="projects-footer animate-on-scroll">
      <a
        href="https://github.com/firerlAGI?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="projects-footer__link"
      >
        <span data-i18n="projects.more">查看更多项目</span>
        <ArrowUpRight size={16} />
      </a>
    </div>
  </Container>
</Section>

<style>
  .projects-grid {
    display: grid;
    gap: 1.2rem;
  }

  .project-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    border-radius: 0.8rem;
    border: 1px solid rgba(229, 231, 235, 0.12);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
      rgba(255, 255, 255, 0.02);
    aspect-ratio: 16 / 10;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      0 16px 36px rgba(2, 6, 23, 0.24);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition:
      filter 0.35s ease,
      transform 0.35s ease;
  }

  .project-card__media::before,
  .project-card__media::after,
  .project-card__media-shine {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .project-card__media::before {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 28%),
      linear-gradient(0deg, rgba(2, 6, 23, 0.32), transparent 44%);
    opacity: 0.78;
  }

  .project-card__media::after {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: inherit;
    box-shadow: inset 0 -28px 48px rgba(2, 6, 23, 0.24);
  }

  .project-card__media-shine {
    width: 42%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.18), transparent);
    transform: translateX(-125%) skewX(-12deg);
    transition: transform 0.55s ease;
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.045);
    filter: saturate(1.08) contrast(1.04);
  }

  .project-card:hover .project-card__media-shine {
    transform: translateX(260%) skewX(-12deg);
  }

  .project-card__fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--primary);
    background: linear-gradient(135deg, rgba(99, 230, 255, 0.1), rgba(255, 119, 221, 0.08));
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .project-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(129, 166, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    color: var(--primary);
  }

  .project-card__note {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .project-card h3 {
    color: var(--text-primary);
    font-size: 1.28rem;
    font-weight: 700;
  }

  .project-card p {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-family: var(--font-family);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  a.project-card__link:hover {
    transform: scale(1.02);
  }

  .project-card__link--primary {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
  }

  .project-card__link--secondary {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
  }

  .project-card__link--muted {
    border: 1px dashed rgba(255, 255, 255, 0.1);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1140px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projects-footer {
    display: flex;
    justify-content: center;
    margin-top: 1.35rem;
  }

  .projects-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .projects-footer__link:hover {
    transform: scale(1.02);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
  }
</style>
