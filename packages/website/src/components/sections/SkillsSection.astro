---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import { Activity as ActivityIcon, GitCommit, Code, Calendar as CalendarIcon } from 'lucide-react'
import { translations } from '../../translations'
import contributionsData from '../../data/contributions'

type Language = 'en' | 'zh'

interface Activity {
  date: string
  count: number
  level: 0 | 1 | 2 | 3 | 4
}

interface Stats {
  loc: number
  days: number
  contribs: number
}

let data: Activity[] = []
let stats: Stats = { loc: 0, days: 0, contribs: 0 }
let loading = false
let error = false

try {
  if (contributionsData && Array.isArray(contributionsData) && contributionsData.length > 0) {
    data = contributionsData
    const contribs = data.reduce((sum, day) => sum + day.count, 0)
    const days = data.filter((day) => day.count > 0).length
    stats = {
      loc: contribs * 25,
      days,
      contribs,
    }
  } else {
    error = true
  }
} catch (e) {
  console.warn('Error loading contributions data:', e)
  error = true
}

const lang: Language = 'en'
const t = translations[lang]
---

<Section sectionId="skills" class="py-16 md:py-24">
  <Container>
    <div class="section-heading-block animate-on-scroll">
      <span class="section-kicker">Signals</span>
      <h2 class="section-title" data-i18n="skills.title">{t.skills.title}</h2>
      <p class="section-description" data-i18n="skills.subtitle">{t.skills.subtitle}</p>
    </div>

    <div class="skills-layout">
      <CyberCard glowColor="cyan" class="animate-on-scroll">
        <div class="skills-panel">
          <div class="skills-panel__header">
            <div>
              <p class="skills-panel__eyebrow">{t.skills.github}</p>
              <h3>{t.skills.sync}</h3>
            </div>
            <div class="skills-panel__meta">
              <span>{t.skills.status}</span>
              <span>{t.skills.latency}</span>
            </div>
          </div>

          <div class="skills-panel__calendar">
            {loading ? (
              <div class="skills-panel__empty">
                <ActivityIcon class="animate-spin" />
                <span>Loading</span>
              </div>
            ) : error ? (
              <div class="skills-panel__empty">
                <span>Unable to load contribution data</span>
              </div>
            ) : (
              <div class="activity-calendar" id="activity-calendar"></div>
            )}
          </div>
        </div>
      </CyberCard>

      <div class="skills-stats">
        <CyberCard glowColor="pink" class="animate-on-scroll">
          <div class="skills-stat-card">
            <div class="skills-stat-card__icon"><Code size={18} /></div>
            <span class="skills-stat-card__label">{t.skills.loc}</span>
            <strong>{stats.loc.toLocaleString()}</strong>
          </div>
        </CyberCard>

        <CyberCard glowColor="cyan" class="animate-on-scroll">
          <div class="skills-stat-card">
            <div class="skills-stat-card__icon"><CalendarIcon size={18} /></div>
            <span class="skills-stat-card__label">{t.skills.activeDays}</span>
            <strong>{stats.days}</strong>
          </div>
        </CyberCard>

        <CyberCard glowColor="pink" class="animate-on-scroll">
          <div class="skills-stat-card">
            <div class="skills-stat-card__icon"><GitCommit size={18} /></div>
            <span class="skills-stat-card__label">{t.skills.contribs}</span>
            <strong>{stats.contribs.toLocaleString()}</strong>
          </div>
        </CyberCard>
      </div>
    </div>
  </Container>
</Section>

<script define:vars={{ data, lang }}>
  const renderCalendar = () => {
    const calendarContainer = document.getElementById('activity-calendar')
    if (!calendarContainer || data.length === 0) return

    const palette = {
      0: 'var(--heatmap-level-0)',
      1: 'var(--heatmap-level-1)',
      2: 'var(--heatmap-level-2)',
      3: 'var(--heatmap-level-3)',
      4: 'var(--heatmap-level-4)',
    }

    const weeks = []
    let currentWeek = []
    const currentDayOfWeek = new Date(data[0].date).getDay()

    for (let i = 0; i < currentDayOfWeek; i += 1) {
      currentWeek.push(null)
    }

    data.forEach((day) => {
      currentWeek.push(day)
      const dayOfWeek = new Date(day.date).getDay()
      if (dayOfWeek === 6) {
        weeks.push(currentWeek)
        currentWeek = []
      }
    })

    if (currentWeek.length > 0) {
      weeks.push(currentWeek)
    }

    const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

    let calendarHTML = '<div class="skills-heatmap">'
    calendarHTML += '<div class="skills-heatmap__weekdays">'
    dayLabels.forEach((day) => {
      calendarHTML += `<span>${day}</span>`
    })
    calendarHTML += '</div>'

    calendarHTML += '<div class="skills-heatmap__weeks">'
    weeks.forEach((week) => {
      calendarHTML += '<div class="skills-heatmap__week">'
      week.forEach((day) => {
        if (!day) {
          calendarHTML += '<span class="skills-heatmap__cell is-empty"></span>'
          return
        }

        calendarHTML += `
          <span
            class="skills-heatmap__cell"
            title="${day.date}: ${day.count} contributions"
            style="background:${palette[day.level]}"
          ></span>
        `
      })
      calendarHTML += '</div>'
    })
    calendarHTML += '</div>'

    const offlineLabel = lang === 'zh' ? '离线' : 'OFFLINE'
    const maxLoadLabel = lang === 'zh' ? '最大负载' : 'MAX_LOAD'
    calendarHTML += `
      <div class="skills-heatmap__legend">
        <span>${offlineLabel}</span>
        <div class="skills-heatmap__legend-scale">
          ${[0, 1, 2, 3, 4].map((level) => `<span style="background:${palette[level]}"></span>`).join('')}
        </div>
        <span>${maxLoadLabel}</span>
      </div>
    `

    calendarHTML += '</div>'
    calendarContainer.innerHTML = calendarHTML
  }

  renderCalendar()
</script>

<style>
  .skills-layout {
    display: grid;
    gap: 1.2rem;
  }

  .skills-panel {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .skills-panel__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skills-panel__eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .skills-panel__header h3 {
    margin-top: 0.55rem;
    color: var(--text-primary);
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    font-weight: 700;
  }

  .skills-panel__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skills-panel__meta span {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(129, 166, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    padding: 0 0.9rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .skills-panel__calendar {
    overflow-x: auto;
  }

  .skills-panel__empty {
    min-height: 14rem;
    display: grid;
    place-items: center;
    color: var(--text-secondary);
    text-align: center;
  }

  .skills-stats {
    display: grid;
    gap: 1rem;
  }

  .skills-stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .skills-stat-card__icon {
    width: 2.7rem;
    height: 2.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    border: 1px solid rgba(129, 166, 255, 0.14);
    color: var(--primary);
    background: rgba(99, 230, 255, 0.08);
  }

  .skills-stat-card__label {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .skills-stat-card strong {
    color: var(--text-primary);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
  }

  .skills-heatmap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 48rem;
  }

  .skills-heatmap__weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.28rem;
    margin-left: 2.1rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .skills-heatmap__weeks {
    display: flex;
    gap: 0.28rem;
  }

  .skills-heatmap__week {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .skills-heatmap__cell {
    width: 0.78rem;
    height: 0.78rem;
    display: inline-block;
    border-radius: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .skills-heatmap__cell.is-empty {
    background: rgba(255, 255, 255, 0.02);
  }

  .skills-heatmap__legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skills-heatmap__legend-scale {
    display: flex;
    gap: 0.22rem;
  }

  .skills-heatmap__legend-scale span {
    width: 0.72rem;
    height: 0.72rem;
    display: inline-block;
    border-radius: 0.2rem;
  }

  @media (min-width: 980px) {
    .skills-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.45fr);
      align-items: start;
    }
  }
</style>
