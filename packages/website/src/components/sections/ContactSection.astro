---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import { Mail, Github, Twitter, MapPin, ArrowUpRight } from 'lucide-react'
import { translations, type Language } from '../../translations'

const lang: Language = 'en'
const t = translations[lang]

const contactItems = [
  {
    icon: Mail,
    label: t.contact.labels.email,
    key: 'contact.labels.email',
    value: 'hello@firerlAGI.com',
    href: 'mailto:hello@firerlAGI.com',
  },
  {
    icon: Github,
    label: t.contact.labels.github,
    key: 'contact.labels.github',
    value: '@firerlAGI',
    href: 'https://github.com/firerlAGI',
  },
  {
    icon: Twitter,
    label: t.contact.labels.twitter,
    key: 'contact.labels.twitter',
    value: '@firerlAGI',
    href: 'https://twitter.com/firerlAGI',
  },
  {
    icon: MapPin,
    label: t.contact.labels.base,
    key: 'contact.labels.base',
    value: 'China / Remote',
  },
]
---

<Section sectionId="contact" class="py-16 md:py-24">
  <Container>
    <div class="contact-grid">
      <div class="section-heading-block animate-on-scroll">
        <span class="section-kicker">Contact</span>
        <h2 class="section-title" data-i18n="contact.title">{t.contact.title}</h2>
        <p class="section-description" data-i18n="contact.summary">
          {t.contact.summary}
        </p>
      </div>

      <CyberCard glowColor="pink" class="animate-on-scroll">
        <div class="contact-card">
          <div>
            <p class="contact-card__label" data-i18n="contact.channels">{t.contact.channels}</p>
            <h3 data-i18n="contact.headline">{t.contact.headline}</h3>
          </div>

          <div class="contact-list">
            {contactItems.map((item) => {
              const Icon = item.icon
              const content = (
                <>
                  <div class="contact-list__icon">
                    <Icon size={18} />
                  </div>
                  <div class="contact-list__copy">
                    <span data-i18n={item.key}>{item.label}</span>
                    <strong>{item.value}</strong>
                  </div>
                  {item.href ? <ArrowUpRight size={16} /> : null}
                </>
              )

              return item.href ? (
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="contact-list__item">
                  {content}
                </a>
              ) : (
                <div class="contact-list__item">{content}</div>
              )
            })}
          </div>
        </div>
      </CyberCard>
    </div>
  </Container>
</Section>

<style>
  .contact-grid {
    display: grid;
    gap: 1.4rem;
    align-items: start;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .contact-card__label {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-card h3 {
    margin-top: 0.7rem;
    color: var(--text-primary);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .contact-list {
    display: grid;
    gap: 0.85rem;
  }

  .contact-list__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(129, 166, 255, 0.12);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.02);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  a.contact-list__item:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 230, 255, 0.26);
    background: rgba(99, 230, 255, 0.05);
  }

  .contact-list__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 1rem;
    border: 1px solid rgba(129, 166, 255, 0.14);
    background: rgba(99, 230, 255, 0.08);
    color: var(--primary);
    flex-shrink: 0;
  }

  .contact-list__copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-list__copy span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-list__copy strong {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
    word-break: break-word;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
