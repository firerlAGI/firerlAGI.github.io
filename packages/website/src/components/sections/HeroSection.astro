---
import Container from '../ui/Container.astro'
import { translations, type Language } from '../../translations'
import githubStatsData from '../../data/github-stats'

const lang: Language = 'en'
const t = translations[lang]

const user = githubStatsData.user
const stats = githubStatsData.stats

const quickStats = [
  {
    label: t.hero.stats.repositories,
    key: 'hero.stats.repositories',
    value: `${stats.repositories}+`,
  },
  {
    label: t.hero.stats.pinned,
    key: 'hero.stats.pinned',
    value: `${githubStatsData.pinnedRepos.length}`,
  },
  {
    label: t.hero.stats.base,
    key: 'hero.stats.base',
    value: user.location || 'Remote',
  },
]
---

<section class="hero-section w-full pt-6 pb-14 md:pb-20 lg:pb-24">
  <Container>
    <div class="hero-shell animate-on-scroll animate-in">
      <div class="hero-copy">
        <span class="eyebrow-chip">
          <span class="eyebrow-chip__dot"></span>
          <span data-i18n="hero.status">{t.hero.status}</span>
        </span>

        <div class="hero-heading">
          <p class="hero-intro" data-i18n="hero.intro">{t.hero.intro}</p>
          <h1 class="hero-title">
            <span class="hero-title__name" data-i18n="hero.title">{t.hero.title}</span>
            <span class="hero-title__accent" data-i18n="hero.accent">{t.hero.accent}</span>
          </h1>
        </div>

        <p class="hero-typeline" id="typewriter-text"></p>
        <p class="hero-subtitle" data-i18n="hero.subtitle">{t.hero.subtitle}</p>

        <div class="hero-actions">
          <a href="#projects" class="hero-button hero-button--primary" data-i18n="hero.cta_work">{t.hero.cta_work}</a>
          <a href="#contact" class="hero-button hero-button--secondary" data-i18n="hero.cta_contact">{t.hero.cta_contact}</a>
        </div>

        <div class="hero-stats">
          {quickStats.map((item) => (
            <div class="stat-chip">
              <span class="stat-chip__label" data-i18n={item.key}>{item.label}</span>
              <span class="stat-chip__value">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-panel">
        <div class="hero-panel__frame">
          <div class="hero-panel__header">
            <span class="hero-panel__tag" data-i18n="hero.panel.snapshot">{t.hero.panel.snapshot}</span>
            <span class="hero-panel__status" data-i18n="hero.panel.live">{t.hero.panel.live}</span>
          </div>

          <div class="hero-panel__body">
            <div class="hero-panel__identity">
              <div class="hero-panel__avatar">
                <img src="/assets/images/avatar-cyberpunk.svg" alt="firerlAGI avatar" />
                <span class="hero-panel__avatar-glass"></span>
              </div>
              <div>
                <p class="hero-panel__label" data-i18n="hero.panel.operator">{t.hero.panel.operator}</p>
                <h2>{user.name}</h2>
                <p class="hero-panel__muted">{user.bio}</p>
              </div>
            </div>

            <div class="soft-divider"></div>

            <div class="hero-panel__grid">
              <div>
                <span class="hero-panel__label" data-i18n="hero.panel.location">{t.hero.panel.location}</span>
                <strong>{user.location || 'Remote'}</strong>
              </div>
              <div>
                <span class="hero-panel__label" data-i18n="hero.panel.focus">{t.hero.panel.focus}</span>
                <strong>AI workflows</strong>
              </div>
              <div>
                <span class="hero-panel__label" data-i18n="hero.panel.stars">{t.hero.panel.stars}</span>
                <strong>{stats.stars}</strong>
              </div>
              <div>
                <span class="hero-panel__label" data-i18n="hero.panel.forks">{t.hero.panel.forks}</span>
                <strong>{stats.forks}</strong>
              </div>
            </div>

            <div class="hero-panel__stack">
              <span class="tech-pill">Astro</span>
              <span class="tech-pill">React</span>
              <span class="tech-pill">TypeScript</span>
              <span class="tech-pill">OpenAI</span>
              <span class="tech-pill">Automation</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { language } from '../../stores/languageStore';
  import { translations } from '../../translations';

  const typewriterText = document.getElementById('typewriter-text');
  let currentTimeout = null;

  function startTypewriter(text) {
    if (!typewriterText) return;

    if (currentTimeout) {
      clearTimeout(currentTimeout);
    }

    let index = 0;
    typewriterText.textContent = '';

    const type = () => {
      if (!typewriterText) return;

      if (index < text.length) {
        typewriterText.textContent = text.slice(0, index + 1) + ' _';
        index += 1;
        currentTimeout = setTimeout(type, 42);
      } else {
        typewriterText.textContent = text;
      }
    };

    type();
  }

  language.subscribe((nextLanguage) => {
    const text = translations[nextLanguage].hero.typewriter;
    startTypewriter(text);
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100vh - 5rem);
    display: flex;
    align-items: center;
  }

  .hero-shell {
    display: grid;
    gap: 1.6rem;
    align-items: stretch;
  }

  .hero-copy,
  .hero-panel__frame {
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 2rem;
    background: var(--card-bg);
    backdrop-filter: blur(40px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .hero-copy {
    padding: clamp(1.6rem, 4vw, 2.8rem);
  }

  .hero-heading {
    margin-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hero-intro {
    max-width: 38rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .hero-title__name {
    display: block;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .hero-title__accent {
    display: block;
    max-width: 13ch;
    font-size: clamp(1.18rem, 2.8vw, 2.1rem);
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--text-secondary);
  }

  .hero-typeline {
    min-height: 1.8rem;
    margin-top: 1.4rem;
    color: color-mix(in srgb, var(--primary) 68%, white 8%);
    font-family: var(--font-mono);
    font-size: 0.94rem;
  }

  .hero-subtitle {
    margin-top: 0.8rem;
    max-width: 37rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.85rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-family: var(--font-family);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-button:hover {
    transform: scale(1.02);
  }

  .hero-button--primary {
    background: var(--text-primary);
    color: var(--bg-primary);
    border: none;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.1);
  }

  .hero-button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }

  .hero-panel__frame {
    position: relative;
    height: 100%;
    padding: 1.45rem;
    overflow: hidden;
  }

  .hero-panel__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.05), transparent 28%);
    pointer-events: none;
  }

  .hero-panel__header,
  .hero-panel__body {
    position: relative;
    z-index: 1;
  }

  .hero-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .hero-panel__tag,
  .hero-panel__status,
  .hero-panel__label {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .hero-panel__tag,
  .hero-panel__status {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .hero-panel__tag {
    color: var(--text-secondary);
  }

  .hero-panel__status {
    color: var(--primary);
  }

  .hero-panel__body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hero-panel__identity {
    display: grid;
    gap: 1rem;
    align-items: center;
  }

  .hero-panel__avatar {
    position: relative;
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 1;
    border-radius: 1.35rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #000000;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.5);
  }

  .hero-panel__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.05);
  }

  .hero-panel__avatar::before,
  .hero-panel__avatar::after,
  .hero-panel__avatar-glass {
    display: none;
  }

  .hero-panel__identity h2 {
    font-size: 1.42rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hero-panel__muted {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    line-height: 1.82;
  }

  .hero-panel__label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-tertiary);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .hero-panel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .hero-panel__grid div {
    padding: 0.92rem 0.98rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.05rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero-panel__grid strong {
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 600;
  }

  .hero-panel__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (min-width: 960px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    }

    .hero-panel__identity {
      grid-template-columns: 11.2rem minmax(0, 1fr);
    }
  }
</style>
