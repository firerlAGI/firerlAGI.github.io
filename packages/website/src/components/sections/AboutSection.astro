---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import { Cpu, Code2, Brain, Zap } from 'lucide-react'
import { translations, type Language } from '../../translations'

const lang: Language = 'en'
const t = translations[lang]

const capabilityItems = [
  {
    icon: Cpu,
    title: t.about.skills.architecture,
    description: t.about.skills.architectureDesc,
  },
  {
    icon: Code2,
    title: t.about.skills.fullstack,
    description: t.about.skills.fullstackDesc,
  },
  {
    icon: Brain,
    title: t.about.skills.ai,
    description: t.about.skills.aiDesc,
  },
  {
    icon: Zap,
    title: t.about.skills.prototyping,
    description: t.about.skills.prototypingDesc,
  },
]
---

<Section sectionId="about" class="py-16 md:py-24">
  <Container>
    <div class="section-heading-block animate-on-scroll">
      <span class="section-kicker">Profile</span>
      <h2 class="section-title" data-i18n="about.profile">{t.about.profile}</h2>
      <p class="section-description" data-i18n="about.summary">
        {t.about.summary}
      </p>
    </div>

    <div class="about-grid">
      <CyberCard glowColor="cyan" class="animate-on-scroll">
        <div class="about-profile">
          <div class="about-profile__visual">
            <div class="about-profile__orb"></div>
            <div class="about-profile__core">
              <img src="/assets/images/avatar-cyberpunk.svg" alt="firerlAGI avatar" />
              <span></span>
            </div>
          </div>

          <div class="about-profile__copy">
            <div>
              <p class="about-profile__eyebrow" data-i18n="about.roleBadge">{t.about.roleBadge}</p>
              <h3 data-i18n="about.headline">{t.about.headline}</h3>
            </div>

            <p data-i18n="about.description1">{t.about.description1}</p>
            <p data-i18n="about.description2">{t.about.description2}</p>

            <div class="about-tags">
              <span class="tech-pill">Product Engineering</span>
              <span class="tech-pill">Automation</span>
              <span class="tech-pill">LLM Integration</span>
              <span class="tech-pill">Frontend Craft</span>
            </div>
          </div>
        </div>
      </CyberCard>

      <div class="about-capabilities">
        {capabilityItems.map((item, index) => {
          const Icon = item.icon
          const glowColor = index % 2 === 0 ? 'pink' : 'cyan'

          return (
            <CyberCard glowColor={glowColor} class="animate-on-scroll">
              <div class="about-capability">
                <div class="about-capability__icon">
                  <Icon size={22} />
                </div>
                <div>
                  <h3 data-i18n={`about.skills.${index === 0 ? 'architecture' : index === 1 ? 'fullstack' : index === 2 ? 'ai' : 'prototyping'}`}>
                    {item.title}
                  </h3>
                  <p>{item.description}</p>
                </div>
              </div>
            </CyberCard>
          )
        })}
      </div>
    </div>

    <CyberCard glowColor="pink" class="mt-6 animate-on-scroll">
      <blockquote class="about-quote" data-i18n="about.quote">{t.about.quote}</blockquote>
    </CyberCard>
  </Container>
</Section>

<style>
  .about-grid {
    display: grid;
    gap: 1.25rem;
  }

  .about-profile {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .about-profile__visual {
    position: relative;
    width: min(100%, 16rem);
    margin: 0 auto;
    aspect-ratio: 1;
  }

  .about-profile__orb,
  .about-profile__core {
    position: absolute;
    inset: 0;
    border-radius: 2rem;
  }

  .about-profile__orb {
    border: 1px solid rgba(99, 230, 255, 0.22);
    background:
      linear-gradient(135deg, rgba(125, 211, 252, 0.18), rgba(251, 191, 36, 0.08)),
      radial-gradient(circle at 70% 78%, rgba(251, 113, 133, 0.14), transparent 48%);
    transform: rotate(-8deg);
  }

  .about-profile__core {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgba(229, 231, 235, 0.14);
    background:
      linear-gradient(135deg, rgba(125, 211, 252, 0.16), rgba(251, 191, 36, 0.08)),
      #07111f;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      0 18px 45px rgba(2, 6, 23, 0.32);
  }

  .about-profile__core img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.08);
    filter: saturate(1.08) contrast(1.05);
  }

  .about-profile__core::before,
  .about-profile__core::after,
  .about-profile__core span {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .about-profile__core::before {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.12), transparent 34%),
      linear-gradient(0deg, rgba(2, 6, 23, 0.28), transparent 52%);
    mix-blend-mode: screen;
  }

  .about-profile__core::after {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: inherit;
  }

  .about-profile__core span {
    background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 100% 8px;
    opacity: 0.26;
  }

  .about-profile__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-profile__eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .about-profile__copy h3 {
    margin-top: 0.65rem;
    color: var(--text-primary);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .about-profile__copy p {
    color: var(--text-secondary);
    line-height: 1.9;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .about-capabilities {
    display: grid;
    gap: 1rem;
  }

  .about-capability {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .about-capability__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(129, 166, 255, 0.16);
    border-radius: 1rem;
    color: var(--primary);
    background: rgba(99, 230, 255, 0.08);
    flex-shrink: 0;
  }

  .about-capability h3 {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
  }

  .about-capability p {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .about-quote {
    color: var(--text-primary);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.8;
    text-align: center;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }

    .about-profile {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }
</style>
