---
import Container from '../ui/Container.astro'
import Section from '../ui/Section.astro'
import CyberCard from '../ui/CyberCard.astro'
import GlitchText from '../ui/GlitchText.astro'
import {
  Star,
  GitFork,
  Users,
  BookOpen,
  Code2,
  Activity,
  MapPin,
  Calendar,
  ExternalLink,
  GitPullRequest,
  IssueOpened,
  Tag,
  Rocket,
} from 'lucide-react'
import { translations, type Language } from '../../translations'

type Language = 'en' | 'zh'

interface GithubUser {
  login: string
  name: string | null
  avatarUrl: string
  bio: string | null
  location: string | null
  company: string | null
  blog: string
  twitterUsername: string | null
  joinedAt: string
}

interface GithubStats {
  repositories: number
  stars: number
  forks: number
  followers: number
  following: number
}

interface LanguageStat {
  name: string
  color: string
  repos: number
  bytes: number
}

interface PinnedRepo {
  name: string
  description: string | null
  url: string
  stars: number
  forks: number
  language: string | null
  languageColor: string | null
}

interface ActivityItem {
  type: string
  repo: string | null
  repoUrl: string | null
  createdAt: string
  payload: {
    action?: string
    ref?: string
    ref_type?: string
    issue?: { number: number; title: string; url: string } | null
    pull_request?: { number: number; title: string; url: string } | null
    release?: { tag_name: string; name: string; url: string } | null
  }
}

interface GithubData {
  user: GithubUser
  stats: GithubStats
  recentActivity: ActivityItem[]
  topLanguages: LanguageStat[]
  pinnedRepos: PinnedRepo[]
  updatedAt: string
}

// ========== 从静态 TypeScript 数据文件获取数据（构建时）==========
// 直接导入 TypeScript 数据文件（Vite/Astro 构建时会自动处理）

import githubStatsData from '../../data/github-stats'

let githubData: GithubData | null = null

try {
  if (githubStatsData && githubStatsData.user && githubStatsData.stats) {
    githubData = githubStatsData
  } else {
    console.warn('Invalid github stats data format')
  }
} catch (error) {
  console.warn('Error loading github stats:', error)
}

const lang: Language = 'en'
const t = translations[lang]

const formatNumber = (num: number) => {
  if (num >= 1000) return (num / 1000).toFixed(1) + 'k'
  return num.toString()
}

const formatTime = (dateString: string) => {
  const date = new Date(dateString)
  const now = new Date()
  const diff = Math.floor((now.getTime() - date.getTime()) / 1000)

  if (diff < 60) return lang === 'zh' ? '刚刚' : 'just now'
  if (diff < 3600) {
    const mins = Math.floor(diff / 60)
    return lang === 'zh' ? `${mins} 分钟前` : `${mins}m ago`
  }
  if (diff < 86400) {
    const hours = Math.floor(diff / 3600)
    return lang === 'zh' ? `${hours} 小时前` : `${hours}h ago`
  }
  if (diff < 604800) {
    const days = Math.floor(diff / 86400)
    return lang === 'zh' ? `${days} 天前` : `${days}d ago`
  }
  return date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short', day: 'numeric' })
}

const getActivityIcon = (type: string) => {
  switch (type) {
    case 'PushEvent': return '📝'
    case 'CreateEvent': return '✨'
    case 'DeleteEvent': return '🗑️'
    case 'WatchEvent': return '⭐'
    case 'ForkEvent': return '🔱'
    case 'IssuesEvent': return '❓'
    case 'IssueCommentEvent': return '💬'
    case 'PullRequestEvent':
    case 'PullRequestReviewEvent': return '🔀'
    case 'ReleaseEvent': return '🎉'
    default: return '📦'
  }
}

const getActivityText = (activity: ActivityItem) => {
  const repoName = activity.repo?.split('/')[1] || activity.repo || ''
  const textsEn: Record<string, () => string> = {
    PushEvent: () => `Pushed to ${repoName}`,
    CreateEvent: () => `Created ${activity.payload.ref_type || repoName}`,
    DeleteEvent: () => `Deleted ${repoName}`,
    WatchEvent: () => `Starred ${repoName}`,
    ForkEvent: () => `Forked ${repoName}`,
    IssuesEvent: () =>
      activity.payload.issue
        ? `Opened issue #${activity.payload.issue.number} in ${repoName}`
        : `Created issue in ${repoName}`,
    IssueCommentEvent: () =>
      activity.payload.issue
        ? `Commented on #${activity.payload.issue.number} in ${repoName}`
        : `Commented in ${repoName}`,
    PullRequestEvent: () =>
      activity.payload.pull_request
        ? `Opened PR #${activity.payload.pull_request.number} in ${repoName}`
        : `Created PR in ${repoName}`,
    PullRequestReviewEvent: () =>
      `Reviewed PR in ${repoName}`,
    ReleaseEvent: () =>
      activity.payload.release
        ? `Released ${activity.payload.release.tag_name || ''} of ${repoName}`
        : `Released ${repoName}`,
  }
  const textsZh: Record<string, () => string> = {
    PushEvent: () => `推送到 ${repoName}`,
    CreateEvent: () => `创建了${activity.payload.ref_type || repoName}`,
    DeleteEvent: () => `删除了 ${repoName}`,
    WatchEvent: () => `Star 了 ${repoName}`,
    ForkEvent: () => `Fork 了 ${repoName}`,
    IssuesEvent: () =>
      activity.payload.issue
        ? `在 ${repoName} 创建了 Issue #${activity.payload.issue.number}`
        : `在 ${repoName} 创建了 Issue`,
    IssueCommentEvent: () =>
      activity.payload.issue
        ? `在 ${repoName} 评论了 Issue #${activity.payload.issue.number}`
        : `在 ${repoName} 发表了评论`,
    PullRequestEvent: () =>
      activity.payload.pull_request
        ? `在 ${repoName} 提交了 PR #${activity.payload.pull_request.number}`
        : `在 ${repoName} 提交了 PR`,
    PullRequestReviewEvent: () =>
      `审查了 ${repoName} 的 PR`,
    ReleaseEvent: () =>
      activity.payload.release
        ? `发布了 ${repoName} 的 ${activity.payload.release.tag_name || ''} 版本`
        : `发布了 ${repoName}`,
  }

  const textFn = lang === 'zh' ? (textsZh[type] || (() => `在 ${repoName} 进行了操作`)) : (textsEn[type] || (() => `Action on ${repoName}`))
  return textFn()
}
---

<Section sectionId="github" class="py-20 px-4">
  <Container class="max-w-[1400px] mx-auto">
    <div class="mb-12">
      <GlitchText text={t.github.title} tag="h2" class="text-4xl md:text-5xl font-bold text-white mb-4" />
      <div class="h-1 w-24 bg-fuchsia-500" />
    </div>

    {githubData ? (
      <div class="space-y-8">
        <!-- User Profile Card -->
        <CyberCard glowColor="fuchsia" class="overflow-hidden">
          <div class="flex flex-col md:flex-row gap-6 p-6 md:p-8">
            <!-- Avatar & Info -->
            <div class="flex items-center gap-6 md:w-80 flex-shrink-0">
              <div class="relative group">
                <img
                  src={githubData.user.avatarUrl}
                  alt={`${githubData.user.name || githubData.user.login}'s avatar`}
                  class="w-24 h-24 rounded-lg border-2 border-fuchsia-500/50 object-cover transition-all duration-300 group-hover:border-fuchsia-400 group-hover:shadow-[0_0_30px_rgba(217,70,239,0.3)]"
                />
                <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 rounded-full border-2 border-black flex items-center justify-center">
                  <div class="w-2 h-2 bg-white rounded-full animate-pulse"></div>
                </div>
              </div>
              <div class="flex-grow min-w-0">
                <h3 class="text-xl font-cyber text-white truncate">{githubData.user.name || githubData.user.login}</h3>
                <p class="text-fuchsia-400 font-mono text-sm">@{githubData.user.login}</p>
                {githubData.user.bio && (
                  <p class="text-gray-400 text-sm mt-2 line-clamp-2">{githubData.user.bio}</p>
                )}
              </div>
            </div>

            <!-- Stats Grid -->
            <div class="flex-grow grid grid-cols-2 sm:grid-cols-4 gap-4">
              <a href={`https://github.com/${githubData.user.login}?tab=repositories`} target="_blank" rel="noopener noreferrer" class="group stat-item">
                <BookOpen size={18} class="text-cyan-400 mb-2 group-hover:scale-110 transition-transform" />
                <div class="text-2xl font-cyber text-white group-hover:text-cyan-300">{formatNumber(githubData.stats.repositories)}</div>
                <div class="text-xs font-mono text-gray-500 uppercase tracking-wider">{t.github.repos}</div>
              </a>

              <a href={`https://github.com/${githubData.user.login}?tab=stars`} target="_blank" rel="noopener noreferrer" class="group stat-item">
                <Star size={18} class="text-yellow-400 mb-2 group-hover:scale-110 transition-transform" />
                <div class="text-2xl font-cyber text-white group-hover:text-yellow-300">{formatNumber(githubData.stats.stars)}</div>
                <div class="text-xs font-mono text-gray-500 uppercase tracking-wider">{t.github.stars}</div>
              </a>

              <a href={`https://github.com/${githubData.user.login}?tab=followers`} target="_blank" rel="noopener noreferrer" class="group stat-item">
                <Users size={18} class="text-fuchsia-400 mb-2 group-hover:scale-110 transition-transform" />
                <div class="text-2xl font-cyber text-white group-hover:text-fuchsia-300">{githubData.stats.followers}</div>
                <div class="text-xs font-mono text-gray-500 uppercase tracking-wider">{t.github.followers}</div>
              </a>

              <a href={`https://github.com/${githubData.user.login}?tab=following`} target="_blank" rel="noopener noreferrer" class="group stat-item">
                <GitFork size={18} class="text-green-400 mb-2 group-hover:scale-110 transition-transform" />
                <div class="text-2xl font-cyber text-white group-hover:text-green-300">{formatNumber(githubData.stats.forks)}</div>
                <div class="text-xs font-mono text-gray-500 uppercase tracking-wider">{t.github.forks}</div>
              </a>
            </div>
          </div>

          <!-- Meta Info Bar -->
          <div class="border-t border-fuchsia-900/50 px-6 md:px-8 py-3 flex flex-wrap gap-4 text-xs font-mono text-gray-500">
            {githubData.user.location && (
              <span class="flex items-center gap-1.5">
                <MapPin size={12} class="text-fuchsia-500/70" />
                {githubData.user.location}
              </span>
            )}
            <span class="flex items-center gap-1.5">
              <Calendar size={12} class="text-cyan-500/70" />
              Joined {new Date(githubData.user.joinedAt).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short' })}
            </span>
            <span class="ml-auto text-gray-600">Updated: {new Date(githubData.updatedAt).toLocaleDateString()}</span>
          </div>
        </CyberCard>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Left Column: Repositories & Languages -->
          <div class="lg:col-span-2 space-y-8">
            <!-- Pinned Repositories -->
            {githubData.pinnedRepos && githubData.pinnedRepos.length > 0 && (
              <CyberCard glowColor="cyan" class="p-0 overflow-hidden">
                <div class="bg-cyan-950/30 border-b border-cyan-500/30 p-4 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <Rocket size={16} className="text-cyan-400" />
                    <h3 class="font-cyber text-sm text-cyan-100 tracking-widest uppercase">{lang === 'zh' ? '置顶仓库' : 'PINNED REPOS'}</h3>
                  </div>
                  <a href={`https://github.com/${githubData.user.login}?tab=repositories`} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-500 hover:text-cyan-400 transition-colors flex items-center gap-1">
                    VIEW ALL <ExternalLink size={10} />
                  </a>
                </div>

                <div class="divide-y divide-cyan-900/30">
                  {githubData.pinnedRepos.map((repo) => (
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block p-4 hover:bg-cyan-900/10 transition-colors group"
                    >
                      <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-grow">
                          <div class="flex items-center gap-2 mb-1">
                            <Code2 size={14} class="text-cyan-500 flex-shrink-0" />
                            <h4 class="font-mono text-sm text-white group-hover:text-cyan-300 transition-colors truncate">{repo.name}</h4>
                          </div>
                          {repo.description && (
                            <p class="text-xs text-gray-500 line-clamp-2 mt-1 ml-5">{repo.description}</p>
                          )}
                        </div>
                        <div class="flex items-center gap-3 text-xs font-mono text-gray-500 flex-shrink-0">
                          {repo.language && (
                            <span class="flex items-center gap-1">
                              <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${repo.languageColor || '#8b949e'}`}></span>
                              <span class="hidden sm:inline">{repo.language}</span>
                            </span>
                          )}
                          {repo.stars > 0 && (
                            <span class="flex items-center gap-0.5 text-yellow-500/80">
                              <Star size={11} /> {repo.stars}
                            </span>
                          )}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </CyberCard>
            )}

            <!-- Top Languages -->
            {githubData.topLanguages && githubData.topLanguages.length > 0 && (
              <CyberCard glowColor="pink" class="p-0 overflow-hidden">
                <div class="bg-fuchsia-950/30 border-b border-fuchsia-500/30 p-4">
                  <div class="flex items-center gap-2">
                    <Tag size={16} className="text-fuchsia-400" />
                    <h3 class="font-cyber text-sm text-fuchsia-100 tracking-widest uppercase">{lang === 'zh' ? '编程语言' : 'TOP LANGUAGES'}</h3>
                  </div>
                </div>

                <div class="p-6 space-y-4">
                  {githubData.topLanguages.map((langStat) => {
                    const maxBytes = Math.max(...githubData.topLanguages.map(l => l.bytes))
                    const percentage = maxBytes > 0 ? (langStat.bytes / maxBytes * 100) : 0

                    return (
                      <div class="language-bar-group">
                        <div class="flex items-center justify-between mb-1.5">
                          <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-sm" style={`background-color: ${langStat.color}`}></span>
                            <span class="text-sm font-mono text-gray-300">{langStat.name}</span>
                          </div>
                          <span class="text-xs font-mono text-gray-500">{langStat.repos} repos</span>
                        </div>
                        <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden border border-gray-800">
                          <div
                            class="h-full rounded-full transition-all duration-700 ease-out"
                            style={`width: ${percentage}%; background-color: ${langStat.color}`}
                          ></div>
                        </div>
                      </div>
                    )
                  })}
                </div>
              </CyberCard>
            )}
          </div>

          <!-- Right Column: Activity Feed -->
          <div class="space-y-8">
            <CyberCard glowColor="cyan" class="p-0 overflow-hidden h-fit">
              <div class="bg-cyan-950/30 border-b border-cyan-500/30 p-4 flex items-center gap-2">
                <Activity size={16} className="text-cyan-400 animate-pulse" />
                <h3 class="font-cyber text-sm text-cyan-100 tracking-widest uppercase">{t.github.recent}</h3>
              </div>

              <div class="max-h-[480px] overflow-y-auto custom-scrollbar">
                <div class="divide-y divide-cyan-900/20">
                  {githubData.recentActivity.slice(0, 12).map((activity) => (
                    <a
                      href={
                        activity.payload?.issue?.url ||
                        activity.payload?.pull_request?.url ||
                        activity.payload?.release?.url ||
                        activity.repoUrl ||
                        '#'
                      }
                      target={(activity.repoUrl || activity.payload?.issue?.url) ? '_blank' : undefined}
                      rel={(activity.repoUrl || activity.payload?.issue?.url) ? 'noopener noreferrer' : undefined}
                      class="block p-4 hover:bg-cyan-900/10 transition-colors group"
                    >
                      <div class="flex items-start gap-3">
                        <span class="text-lg mt-0.5 flex-shrink-0">{getActivityIcon(activity.type)}</span>
                        <div class="min-w-0 flex-grow">
                          <p class="text-sm text-gray-300 leading-relaxed line-clamp-2">
                            {getActivityText(activity)}
                          </p>
                          <span class="text-xs font-mono text-gray-600 mt-1 block">{formatTime(activity.createdAt)}</span>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </CyberCard>

            <!-- Quick Links -->
            <div class="grid grid-cols-2 gap-3">
              <a
                href={`https://github.com/${githubData.user.login}`}
                target="_blank"
                rel="noopener noreferrer"
                class="cyber-btn cyber-btn-primary"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                {t.github.visit}
              </a>
              <a
                href="#contact"
                class="cyber-btn cyber-btn-secondary"
              >
                CONTACT
              </a>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <CyberCard glowColor="red" class="p-12 text-center">
        <Activity size={48} class="mx-auto text-red-400/50 animate-pulse mb-4" />
        <p class="font-mono text-red-400">{lang === 'zh' ? '无法加载 GitHub 数据' : 'GITHUB DATA UNAVAILABLE'}</p>
        <p class="text-sm text-gray-600 mt-2 font-mono">{lang === 'zh' ? '请稍后再试或检查网络连接' : 'Please try again later or check your connection'}</p>
      </CyberCard>
    )}
  </Container>
</Section>

<style>
  .stat-item {
    @apply p-4 rounded-lg bg-black/30 border border-gray-800 text-center transition-all duration-300 cursor-pointer;
  }

  .stat-item:hover {
    @apply border-current;
    box-shadow: 0 0 20px currentColor;
  }

  .cyber-btn {
    @apply relative px-6 py-3 font-cyber text-xs font-medium tracking-widest uppercase text-center no-underline rounded overflow-hidden transition-all duration-250 border cursor-pointer;
  }

  .cyber-btn-primary {
    @apply bg-cyan-500/10 border-cyan-400 text-cyan-400;
  }

  .cyber-btn-primary:hover {
    @apply shadow-[0_0_20px_rgba(34,211,238,0.3)];
  }

  .cyber-btn-secondary {
    @apply bg-fuchsia-500/10 border-fuchsia-500 text-fuchsia-400;
  }

  .cyber-btn-secondary:hover {
    @apply shadow-[0_0_20px_rgba(255,0,255,0.3)];
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(34, 211, 238, 0.2);
    border-radius: 2px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(34, 211, 238, 0.4);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .lg\:col-span-2 {
      grid-column: span 1;
    }
  }
</style>
